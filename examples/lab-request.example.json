{
  "schemaVersion": "1.0.0",
  "id": "authorized-adventure-study",
  "title": "Authorized legacy adventure reconstruction",
  "source": {
    "kind": "directory",
    "path": "./owned-game-copy",
    "manifestPath": "./source-manifest.json",
    "formatHint": "scumm-v5",
    "ownershipConfirmed": true,
    "provenance": "user-owned installation"
  },
  "ai": {
    "gateway": "bellows",
    "baseUrlEnv": "BELLOWS_BASE_URL",
    "apiKeyEnv": "BELLOWS_API_KEY",
    "modelEnv": "BELLOWS_MODEL"
  },
  "intent": {
    "target": "shaded",
    "mode": "faithful-remaster",
    "preserve": [
      "puzzle causality",
      "character timing",
      "scene readability",
      "music transition intent"
    ]
  },
  "options": {
    "actors": {
      "width": 96,
      "height": 96,
      "colors": 24,
      "backgroundRemoval": "ai",
      "rembgModel": "u2net",
      "baselineNormalization": false
    },
    "world": {
      "act": "tag",
      "params": {
        "wet": 0.15,
        "wind": 0.2,
        "glow": 0.25
      },
      "time": 15.5,
      "freezeTime": true
    }
  }
}
