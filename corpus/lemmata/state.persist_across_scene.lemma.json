{
  "lemmaVersion": "0.1.0",
  "id": "state.persist_across_scene",
  "intent": "preserve semantic state when moving across scene boundaries",
  "contract": {
    "contractVersion": "0.1.0",
    "id": "state.persist_across_scene.contract",
    "kind": "function",
    "source": {
      "type": "lemma",
      "provenance": "corpus/lemmata"
    },
    "inputs": [
      "world_state",
      "scene_exit"
    ],
    "preconditions": [
      "subject_exists"
    ],
    "reads": [
      "state.key",
      "handoff.payload"
    ],
    "writes": [
      "handoff.payload",
      "state.key"
    ],
    "side_effects": [
      "emit semantic_state_changed"
    ],
    "postconditions": [
      "state_restored_after_entry",
      "handoff_contains_required_key"
    ],
    "error_behavior": [
