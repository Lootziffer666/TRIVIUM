{
  "lemmaVersion": "0.1.0",
  "id": "passage.make_traversable",
  "intent": "make a previously blocked passage traversable",
  "contract": {
    "contractVersion": "0.1.0",
    "id": "passage.make_traversable.contract",
    "kind": "function",
    "source": {
      "type": "lemma",
      "provenance": "corpus/lemmata"
    },
    "inputs": [
      "passage_state"
    ],
    "preconditions": [
      "subject_exists"
    ],
    "reads": [
      "passage.blocked",
      "navigation.version"
    ],
    "writes": [
      "passage.blocked",
      "collision.enabled",
      "navigation.version"
    ],
    "side_effects": [
      "emit semantic_state_changed"
    ],
    "postconditions": [
      "passage_traversable",
      "collision_no_longer_blocks",
      "navigation_can_cross"
    ],
    "error_behavior": [
      "missing_subject_is_reported"
    ],
    "must_not": [
      "visually_open_but_physically_blocked"
    ]
  },
  "idioms": {
