  "tests": [
    {
      "given": [
        "passage is blocked",
        "actor is before passage"
      ],
      "when": [
        "make_traversable is applied"
      ],
      "then": [
        "passage.blocked is false",
        "actor can cross"
      ]
    },
    {
      "given": [
        "passage is already traversable"
      ],
      "when": [
        "make_traversable is applied again"
      ],
      "then": [
        "state remains traversable",
        "no contradictory collision state appears"
      ]
    }
