    },
    "godot": {
      "constructs": [
        "CollisionShape disabled",
        "NavigationRegion update",
        "Resource-backed state flag"
      ],
      "lifecycle": "bind in scene tree readiness and react through signals or state changes",
      "notes": "descriptive idiom only; D2 owns code generation",
