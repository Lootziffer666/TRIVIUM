    },
    "inputs": [
      "interaction_attempt",
      "hidden_state"
    ],
    "preconditions": [
      "subject_exists"
    ],
    "reads": [
      "hidden_state.value",
      "gate.threshold"
    ],
    "writes": [
      "world.reaction",
      "memory.attempts"
    ],
    "side_effects": [
      "emit semantic_state_changed"
    ],
    "postconditions": [
      "success_when_gate_passes",
      "failed_attempt_teaches_player"
    ],
    "error_behavior": [
      "missing_subject_is_reported"
    ],
    "must_not": [
