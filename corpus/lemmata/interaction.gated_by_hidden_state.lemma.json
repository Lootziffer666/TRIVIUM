{
  "lemmaVersion": "0.1.0",
  "id": "interaction.gated_by_hidden_state",
  "intent": "allow an interaction only when hidden state satisfies a gate and always provide onFail feedback",
  "contract": {
    "contractVersion": "0.1.0",
    "id": "interaction.gated_by_hidden_state.contract",
